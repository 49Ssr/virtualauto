{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/49Ssr/virtualauto/lab/schemas/environment-profile.schema.json",
  "title": "VirtualAuto environment profile",
  "description": "A versioned ownership and parameter contract for an automotive render environment. The schema records implementation state and provenance; it does not assert physical calibration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "id",
    "name",
    "status",
    "blender_version",
    "render_engine",
    "purpose",
    "ownership",
    "world",
    "direct_lighting",
    "atmosphere",
    "ground",
    "weather",
    "camera",
    "diagnostics",
    "limitations"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^ENV-[A-Z0-9]+(?:-[A-Z0-9]+)+$"},
    "name": {"type": "string", "minLength": 3},
    "status": {
      "enum": [
        "P0-idea",
        "P1-specified",
        "P2-buildable",
        "P3-executed",
        "P4-observed",
        "P5-production-qualified",
        "rejected",
        "superseded"
      ]
    },
    "blender_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "render_engine": {"enum": ["Cycles", "EEVEE", "Workbench", "not-applicable"]},
    "purpose": {"type": "string", "minLength": 10},
    "source_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 3},
      "uniqueItems": true
    },
    "ownership": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3},
      "uniqueItems": true
    },
    "world": {"$ref": "#/$defs/world"},
    "direct_lighting": {"$ref": "#/$defs/direct_lighting"},
    "atmosphere": {"$ref": "#/$defs/atmosphere"},
    "ground": {"$ref": "#/$defs/ground"},
    "weather": {"$ref": "#/$defs/weather"},
    "camera": {"$ref": "#/$defs/camera"},
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3},
      "uniqueItems": true
    },
    "experiment_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^EXP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"},
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3}
    },
    "supersedes": {"type": ["string", "null"], "pattern": "^ENV-[A-Z0-9]+(?:-[A-Z0-9]+)+$"}
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "status", "notes"],
      "properties": {
        "value": {
          "type": ["number", "integer", "string", "boolean", "array", "null"],
          "items": {"type": ["number", "integer", "string", "boolean"]}
        },
        "unit": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "manufacturer-disclosed",
            "measured",
            "derived",
            "calibrated",
            "artist-default",
            "implementation-default",
            "unresolved"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 3},
          "uniqueItems": true
        },
        "notes": {"type": "string"}
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "visible_to_camera", "lighting_owner", "parameters"],
      "properties": {
        "mode": {"enum": ["constant", "Preetham", "Hosek-Wilkie", "Nishita", "HDRI", "hybrid", "unresolved"]},
        "visible_to_camera": {"type": "boolean"},
        "lighting_owner": {"type": "string", "minLength": 3},
        "asset_id": {"type": ["string", "null"]},
        "parameters": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/parameter"}
        }
      }
    },
    "direct_lighting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sun_owner", "parameters", "other_emitters"],
      "properties": {
        "sun_owner": {"enum": ["none", "world-sky", "HDRI", "Sun-light", "deliberately-split", "unresolved"]},
        "parameters": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/parameter"}
        },
        "other_emitters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role", "parameters"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 3},
              "parameters": {
                "type": "object",
                "additionalProperties": {"$ref": "#/$defs/parameter"}
              }
            }
          }
        }
      }
    },
    "atmosphere": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation", "bounded", "parameters", "visibility_targets"],
      "properties": {
        "representation": {"enum": ["none", "World-volume", "bounded-volume", "layered-volumes", "compositor-only", "hybrid", "unresolved"]},
        "bounded": {"type": "boolean"},
        "parameters": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/parameter"}
        },
        "visibility_targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["distance_m", "target", "status"],
            "properties": {
              "distance_m": {"type": "number", "exclusiveMinimum": 0},
              "target": {"type": "string", "minLength": 3},
              "status": {"enum": ["specified", "measured", "unresolved"]}
            }
          }
        }
      }
    },
    "ground": {
      "type": "object",
      "additionalProperties": false,
      "required": ["construction_class", "surface_state", "world_scale_m", "parameters"],
      "properties": {
        "construction_class": {"type": "string", "minLength": 3},
        "surface_state": {"enum": ["dry", "dusty-dry", "spotted", "damp", "wet-film", "flowing", "ponded", "icy", "snowy", "mixed", "unresolved"]},
        "world_scale_m": {"type": "number", "exclusiveMinimum": 0},
        "parameters": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/parameter"}
        }
      }
    },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "cloud_state", "precipitation", "wind", "recent_history"],
      "properties": {
        "type": {"type": "string", "minLength": 3},
        "cloud_state": {"$ref": "#/$defs/parameter"},
        "precipitation": {"$ref": "#/$defs/parameter"},
        "wind": {"$ref": "#/$defs/parameter"},
        "recent_history": {"type": "string", "minLength": 3}
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exposure", "white_balance", "display_transform", "lens", "post_effects"],
      "properties": {
        "exposure": {"$ref": "#/$defs/parameter"},
        "white_balance": {"$ref": "#/$defs/parameter"},
        "display_transform": {"type": "string", "minLength": 1},
        "lens": {"$ref": "#/$defs/parameter"},
        "post_effects": {
          "type": "array",
          "items": {"type": "string", "minLength": 2},
          "uniqueItems": true
        }
      }
    }
  }
}