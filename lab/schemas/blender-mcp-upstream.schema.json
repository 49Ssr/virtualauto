{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/49Ssr/virtualauto/lab/schemas/blender-mcp-upstream.schema.json",
  "title": "VirtualAuto Blender MCP upstream lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verified_at",
    "upstream",
    "release",
    "compatibility",
    "security_boundary"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "verified_at": {"type": "string", "format": "date"},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_url", "repository_url", "tag", "commit"],
      "properties": {
        "project_url": {"type": "string", "format": "uri"},
        "repository_url": {"type": "string", "format": "uri"},
        "tag": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_url",
        "addon_url",
        "addon_sha256",
        "source_archive_url",
        "source_archive_sha256"
      ],
      "properties": {
        "page_url": {"type": "string", "format": "uri"},
        "addon_url": {"type": "string", "format": "uri"},
        "addon_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_archive_url": {"type": "string", "format": "uri"},
        "source_archive_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream_minimum_blender", "virtualauto_live_target"],
      "properties": {
        "upstream_minimum_blender": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "virtualauto_live_target": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}
      }
    },
    "security_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bind",
        "arbitrary_python_execution",
        "upstream_sandbox_strength",
        "virtualauto_policy"
      ],
      "properties": {
        "bind": {"const": "localhost:9876"},
        "arbitrary_python_execution": {"const": true},
        "upstream_sandbox_strength": {"const": "weak"},
        "virtualauto_policy": {"type": "string", "minLength": 1}
      }
    }
  }
}
